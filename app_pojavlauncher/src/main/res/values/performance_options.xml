<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="preference_target_fps_title">Frame rate limit</string>
    <string name="preference_show_fps_title">Show FPS counter</string>
    <string name="preference_show_fps_description">Shows the game\'s real frame rate at the top of the screen. Handy for comparing settings on your device.</string>
    <string name="preference_jvm_preset_title">JVM tuning preset (applies on next launch)</string>
    <string name="preference_adaptive_fps_title">Adaptive FPS cap (battery/thermal)</string>
    <string name="preference_adaptive_fps_description">Lowers the frame rate automatically on low battery or heavy heat throttling. Never raises your own chosen cap.</string>
    <string name="preference_device_compat_title">Device &amp; compatibility info</string>
    <string name="preference_auto_ltw_title">Use LTW automatically for 1.17+</string>
    <string name="preference_auto_ltw_description">Versions 1.17 and newer start with the LTW renderer, decided from the version\'s own files. Turn off to use the renderer you picked.</string>
    <string name="preference_angle_egl_title">ANGLE EGL under LTW (experimental)</string>
    <string name="preference_angle_egl_description">Uses the bundled ANGLE library as the EGL layer under LTW. Not tested on most devices and may crash. Off by default. Android 8.0+ only.</string>

