<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <net.kdt.pojavlaunch.prefs.BackButtonPreference/>

    <PreferenceCategory android:title="@string/preference_category_video" >
        <Preference
            android:key="videoProcessor"
            android:title="@string/video_processor_title"
            android:summary="@string/video_processor_summary"
            android:icon="@drawable/ic_setting_engine"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceVideoProcessorFragment"
            app2:allowDividerAbove="true"
            />

        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="ignoreNotch"
            android:summary="@string/mcl_setting_subtitle_ignore_notch"
            android:title="@string/mcl_setting_title_ignore_notch"
            android:icon="@drawable/ic_setting_hide_notch"
            />

        <SwitchPreference
            android:title="@string/preference_sustained_performance_title"
            android:summary="@string/preference_sustained_performance_description"
            android:key="sustainedPerformance"
            android:defaultValue="false"
            />

        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="alternate_surface"
            android:summary="@string/mcl_setting_subtitle_use_surface_view"
            android:title="@string/mcl_setting_title_use_surface_view"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="force_vsync"
            android:summary="@string/preference_force_vsync_description"
            android:title="@string/preference_force_vsync_title"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="vsync_in_zink"
            android:summary="@string/preference_vsync_in_zink_description"
            android:title="@string/preference_vsync_in_zink_title"
            />
        <androidx.preference.ListPreference
            android:key="targetFps"
            android:title="@string/preference_target_fps_title"
            android:dialogTitle="@string/preference_target_fps_title"
            android:entries="@array/target_fps_entries"
            android:entryValues="@array/target_fps_values"
            android:defaultValue="0"
            app2:useSimpleSummaryProvider="true"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="showFps"
            android:summary="@string/preference_show_fps_description"
            android:title="@string/preference_show_fps_title"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="adaptiveFps"
            android:summary="@string/preference_adaptive_fps_description"
            android:title="@string/preference_adaptive_fps_title"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="autoLtw117"
            android:summary="@string/preference_auto_ltw_description"
            android:title="@string/preference_auto_ltw_title"
            />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="angleEglLtw"
            android:summary="@string/preference_angle_egl_description"
            android:title="@string/preference_angle_egl_title"
            />
        <androidx.preference.Preference
            android:key="deviceCompatInfo"
            android:persistent="false"
            android:title="@string/preference_device_compat_title"
            />
    </PreferenceCategory>
</PreferenceScreen>